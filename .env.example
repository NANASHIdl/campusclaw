# 复制为 .env 后填写真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，切勿提交真实口令与密钥。

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root-password
DB_NAME=campusclaw
DB_USER=campusclaw
DB_PASSWORD=change-me-app-password

# --- api 会话密钥（必需）---
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- 种子口令（仅首次启动建库时使用，之后可留空）---
SEED_TEACHER_PASSWORD=teach123
SEED_STUDENT_PASSWORD=stu123

# --- 可选调参 ---
# web 向宿主机发布的端口（默认 8080；若被占用可改）
WEB_PORT=8080
# 单文件上限（字节），默认 5MB
MAX_UPLOAD_BYTES=5242880
# 登录限流：窗口内最大尝试次数 / 窗口秒数
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
# 访问令牌有效期（秒）。JWT 的 exp 由它决定，默认 86400（24 小时）
SESSION_TTL_SECONDS=86400

# --- 向量库（第 4 课）---
# Qdrant 只存在于容器网络内部，无需映射宿主机端口
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=campusclaw_chunks
# 向量维度，须与嵌入网关输出一致（VECTOR_DIM 优先，EMBEDDING_DIM 为别名）
VECTOR_DIM=2048
# EMBEDDING_DIM=2048

# --- 嵌入网关（可选）---
# 留空则使用「本地确定性嵌入」回退：链路仍可离线运行与验收，
# 但只具备词面近似能力，不具备语义泛化。接入课程网关时填写下面三项。
# 课程网关示例：
#   EMBEDDING_BASE_URL=https://ai-gateway.devops.hello1023.com/v1
#   EMBEDDING_MODEL=course-embedding
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# 仅本地回退生效：背景分量权重 α。cos = (α² + 词面重叠) / (α² + 1)。
# 调大 → 相似度整体抬高；调小 → 更严格。默认 0.60 已标定到阈值 0.35 两侧。
LOCAL_EMBED_BIAS=0.60

# ⚠️ 切换嵌入实现（本地回退 ⇄ 网关）或更换嵌入模型后，向量空间完全改变，
#    已有向量全部失效，必须重建索引：清空向量卷后重启
#        docker compose down -v && docker compose up --build -d
#    或由教师对每份材料调用 POST /api/materials/{id}/reindex。

# --- 对话网关（可选）---
# 留空则使用「抽取式回答」回退：从命中切片中摘取最相关的一句并标注出处。
# 与嵌入网关同源，接口为 POST {CHAT_BASE_URL}/chat/completions。
# 课程网关示例：
#   CHAT_BASE_URL=https://ai-gateway.devops.hello1023.com/v1
#   CHAT_MODEL=course-chat
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=course-chat
# 单次对话请求超时（秒）。推理型模型耗时较长，默认 60。
CHAT_TIMEOUT_SECONDS=60

# --- 检索参数（第 4 课）---
# 余弦相似度下限：低于此值的向量候选被丢弃
VECTOR_THRESHOLD=0.35
# RRF 融合常数 k：合成分 = Σ 1/(k + 名次)
RRF_K=60
# 单次检索返回的最大条数
SEARCH_LIMIT=10
# 问答时取前几条切片交给对话模块
ASK_TOP_N=4
